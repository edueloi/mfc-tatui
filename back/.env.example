# Configuração do Banco de Dados MySQL

# Host do MySQL
DB_HOST=localhost

# Porta do MySQL (padrão 3306)
DB_PORT=3306

# Usuário do MySQL
DB_USER=root

# Senha do MySQL
DB_PASSWORD=

# Nome do banco de dados
DB_NAME=mfc_system

# Porta do servidor backend
PORT=4000

# Domínios (SEO e links públicos). SITE_URL = site e inscrições sem login; PAINEL_URL = sistema com login.
# Sem SITE_URL (desenvolvimento), tudo fica junto e o site abre em /site/.
SITE_URL=https://mfctatui.org
PAINEL_URL=https://painel.mfctatui.org
